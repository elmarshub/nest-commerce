# Copy this file to .env and fill in real values. Never commit .env.

# Port the Nest app listens on
PORT=3001

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/commerce?sslmode=require"

# JWT access token — random secret, expressed in seconds
JWT_SECRET=
JWT_EXPIRES_IN=900

# JWT refresh token secret
JWT_REFRESH_SECRET=

# Stripe API keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys) — used for transactional email
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Base URL of the frontend app, used to build links in emails (e.g. password reset)
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (CORS)
ALLOWED_ORIGINS=http://localhost:3000

# First admin account, created by `npm run db:seed`. Leave unset to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
