# Copy to .env.local and adjust if the API runs elsewhere.

# NestJS API base URL — bare host, no /api/v1 suffix. The generated
# OpenAPI paths already include the global prefix, so adding it here
# would double it up. Server-only (no NEXT_PUBLIC_ prefix) — all calls to
# the backend happen from Server Components/Actions per the BFF auth
# architecture in FRONTEND.md, never directly from the browser.
API_URL=http://127.0.0.1:3001

# Stripe publishable key (safe to expose client-side — pair of the
# secret key already configured in api/.env). Get it from
# https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
